//=============================================================

type OrderBy struct {
	items []orderByItem
}

func (o *OrderBy) Asc(column string) *OrderBy {
	o.items = append(o.items, orderByItem{column: column, seq: orderBySeq_.asc})
	return o
}

func (o *OrderBy) Desc(column string) *OrderBy {
	o.items = append(o.items, orderByItem{column: column, seq: orderBySeq_.desc})
	return o
}

func (o *OrderBy) write(nameMap map[string]string, b *orm.PlainSqlBuilder) {
	b.Repeat(len(o.items), b.SepFix(" ORDER BY ", ", ", "", false), nil, func(_, i int) {
		item := o.items[i]
		b.Write(mapColumn(nameMap, item.column)).Write(" ")
		b.Write(item.seq.sql)
	})
}

type Paging struct {
	offset, pageSize int
}

func Order() *OrderBy {
	return &OrderBy{}
}

func Page(offset, pageSize int) *Paging {
	return &Paging{offset: offset, pageSize: pageSize}
}

func And() *CondGroup {
	return &CondGroup{or: false}
}

func Or() *CondGroup {
	return &CondGroup{or: true}
}

func Not() not {
	return not{}
}

