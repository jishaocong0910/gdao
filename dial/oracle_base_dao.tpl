type cond interface {
	notEmpty() bool
	setNot()
	write(nameMap map[string]string, b *orm.PlainSqlBuilder)
}

type baseCond struct {
	not           bool
	parenthesized bool
}

func (bc *baseCond) notEmpty() bool {
	return true
}

func (bc *baseCond) setNot() {
	bc.not = true
}

func (bc *baseCond) doWrite(b *orm.PlainSqlBuilder, write func()) {
	if bc.not {
		b.Write("NOT ")
	}
	if bc.parenthesized {
		b.Write("(")
	}
	write()
	if bc.parenthesized {
		b.Write(")")
	}
}

type not struct{}

func (n not) And() *CondGroup {
	return &CondGroup{baseCond: baseCond{not: true}, or: false}
}

func (n not) Or() *CondGroup {
	return &CondGroup{baseCond: baseCond{not: true}, or: true}
}

type CondGroup struct {
	baseCond
	nextNot bool
	or      bool
	cs      []cond
}

func (cg *CondGroup) notEmpty() bool {
	if cg == nil {
		return false
	}
	return len(cg.cs) > 0
}

func (cg *CondGroup) write(nameMap map[string]string, b *orm.PlainSqlBuilder) {
	cg.doWrite(b, func() {
		for i, c := range cg.cs {
			if i != 0 {
				if cg.or {
					b.Write(" OR ")
				} else {
					b.Write(" AND ")
				}
			}
			c.write(nameMap, b)
		}
	})
}

func (cg *CondGroup) add(other cond) *CondGroup {
	if other != nil && other.notEmpty() {
		if cg.nextNot {
			other.setNot()
			cg.nextNot = false
			if g, ok := other.(*CondGroup); ok {
				if len(g.cs) > 1 {
					g.parenthesized = true
				}
			}
		}
		if len(cg.cs) == 1 {
			if cg.not {
				cg.parenthesized = true
			}
			first := cg.cs[0]
			if g, ok := first.(*CondGroup); ok {
				if g.or && len(g.cs) > 1 {
					g.parenthesized = true
				}
			}
		}
		if len(cg.cs) > 0 {
			if g, ok := other.(*CondGroup); ok {
				if g.or && len(g.cs) > 1 {
					g.parenthesized = true
				}
			}
		}
		cg.cs = append(cg.cs, other)
	}
	return cg
}

func (cg *CondGroup) ToStrArgs(nameMap map[string]string) (string, []any) {
	b := &orm.PlainSqlBuilder{}
	cg.write(nameMap, b)
	return b.Sql(), b.Args()
}

func (cg *CondGroup) Not() *CondGroup {
	cg.nextNot = true
	return cg
}

func (cg *CondGroup) Add(other *CondGroup) *CondGroup {
	return cg.add(other)
}

func (cg *CondGroup) Plain(sql string, args ...any) *CondGroup {
	return cg.add(&condPlain{sql: sql, args: args})
}

func (cg *CondGroup) Eq(column string, arg any, opts ...CondOpt) *CondGroup {
	opt := cg.getOpt(opts...)
	if opt.ifPresent && arg == nil {
		return cg
	}
	if opt.ifPredicate != nil {
		if !opt.ifPredicate() {
			return cg
		}
	}
	return cg.add(&condBinOp{column: column, op: "=", arg: arg})
}

func (cg *CondGroup) Ne(column string, arg any, opts ...CondOpt) *CondGroup {
	opt := cg.getOpt(opts...)
