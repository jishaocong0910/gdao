	return &insertBatch[T]{dao: d}
}

func (d *baseDao[T]) Update() *update[T] {
	return &update[T]{dao: d}
}

func (d *baseDao[T]) UpdateBatch() *updateBatch[T] {
	return &updateBatch[T]{dao: d}
}

func (d *baseDao[T]) Delete() *delete[T] {
	return &delete[T]{dao: d}
}

func (d *baseDao[T]) LogicalDelete() *logicalDelete[T] {
	return &logicalDelete[T]{dao: d}
}

func (d *baseDao[T]) Count() *count[T] {
	return &count[T]{dao: d}
}

func (d *baseDao[T]) determineCond(cg *CondGroup, deletion bool) *CondGroup {
	if deletion || d.logicalDelCfg == nil {
		return cg
	}
	return And().Add(cg).Add(And().Eq(d.logicalDelCfg.Column, d.logicalDelCfg.QueryValue))
}

type baseDaoBuilder[T orm.Entity] struct {
	baseDao      *baseDao[T]
	db           *sql.DB
	columnMapper *orm.NameMapper
}

func (b *baseDaoBuilder[T]) DB(db *sql.DB) *baseDaoBuilder[T] { // coverage-ignore
	b.db = db
	return b
}

func (b *baseDaoBuilder[T]) ColumnMapper(columnMapper *orm.NameMapper) *baseDaoBuilder[T] { // coverage-ignore
	b.columnMapper = columnMapper
	return b
}

func (b *baseDaoBuilder[T]) LogicalDelCfg(logicalDelCfg *LogicalDelCfg) *baseDaoBuilder[T] {
	b.baseDao.logicalDelCfg = logicalDelCfg
	return b
}

func (b *baseDaoBuilder[T]) Build() *baseDao[T] {
	dao := orm.DaoBuilder[T]().DB(b.db).ColumnMapper(b.columnMapper).Build()
	b.baseDao.Dao = dao
	b.baseDao.fieldNameToColumn = *(*map[string]string)(unsafe.Pointer(reflect.ValueOf(dao).Elem().FieldByName("fieldNameToColumn").UnsafeAddr()))
	return b.baseDao
}

func BaseDaoBuilder[T orm.Entity]() *baseDaoBuilder[T] {
	return &baseDaoBuilder[T]{baseDao: &baseDao[T]{}}
}

