type condOpt struct {
	ifPresent   bool
	ifPredicate func() bool
}

type CondOpt func(*condOpt)

func WithIfPresent() CondOpt {
	return func(opt *condOpt) {
		opt.ifPresent = true
	}
}

func WithIfPredicate(predicate func() bool) CondOpt {
	return func(opt *condOpt) {
		opt.ifPredicate = predicate
	}
}

